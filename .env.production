# Points directly at the formera-api Cloud Run service rather than
# relative /api/... paths through the Firebase Hosting rewrite in
# firebase.json. That rewrite was tried specifically to make cookies
# same-origin (avoiding third-party cookie blocking), but Firebase
# Hosting's CDN silently strips the Cookie header from GET requests it
# forwards to Cloud Run (confirmed: POST /api/auth/login/ and POST
# /api/auth/refresh/ worked through the rewrite, but every GET -- /me/,
# /customers/, etc. -- came back 401 with no credentials received at all,
# even though the same cookie worked when sent directly to Cloud Run).
# Reverted to direct cross-origin calls, relying on
# AUTH_COOKIE_SAMESITE=None on the backend instead. The firebase.json
# rewrite is left in place but is now unused by the app; the real fix for
# the third-party-cookie-blocking risk this was working around is a real
# custom domain shared between frontend and API.
VITE_API_URL=https://formera-api-833262393415.us-west2.run.app
